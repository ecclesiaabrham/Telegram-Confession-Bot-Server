BOT_TOKEN=
BOT_OWNER_ID=

# sqlite, mysql, or postgres (Neon)
DB_BACKEND=sqlite
DATABASE_PATH=/data/confessions.sqlite3
# Neon CLI deploy provides DATABASE_URL when PostgreSQL is configured.
DATABASE_URL=
PG_POOL_SIZE=5

# Required only when DB_BACKEND=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=10

MAX_MESSAGE_LENGTH=3000
SUBMISSION_COOLDOWN_SECONDS=60
MAX_SUBMISSIONS_PER_HOUR=5
DATA_RETENTION_DAYS=21
